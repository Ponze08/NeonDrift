{
  "id": "./",
  "name": "Neon Drift: Skyline Rush",
  "short_name": "Neon Drift",
  "description": "Ride the light through an endless original neon skyline.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#040611",
  "theme_color": "#080b1c",
  "categories": ["games", "entertainment"],
  "icons": [
    {
      "src": "./icons/neon-drift-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/neon-drift-icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/neon-drift-maskable.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Launch a run",
      "short_name": "Run",
      "description": "Open Neon Drift and start a skyline run.",
      "url": "./?action=play",
      "icons": [
        { "src": "./icons/neon-drift-icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }
      ]
    }
  ]
}
